# Supabase (required) — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (required for AI planning/chat features)
OPENAI_API_KEY=

# Google Calendar OAuth (Milestone: calendar sync)
# Same OAuth Client as Supabase login; add <your-app-url>/api/calendar/google/callback
# to its Authorized redirect URIs.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Symmetric key (32 random bytes, base64) used to encrypt calendar OAuth
# tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Microsoft/Outlook Calendar OAuth (V2)
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Weather provider for "leave now" / weather notifications, and AI Activity Discovery (V2)
WEATHER_API_KEY=

# USDA FoodData Central — food search for the nutrition/calorie tracker (V2)
# Get a free key instantly at https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=

# Places provider for AI Activity Discovery (V2) — e.g. Geoapify (free tier, no card required)
PLACES_API_KEY=

# Ticketmaster Discovery API — live local events for Discover (free key, no approval process)
# Get one at https://developer-acct.ticketmaster.com
TICKETMASTER_API_KEY=

# Optional additional Discover 3.0 place-data sources — merged with Geoapify results
# (ratings, review counts, richer descriptions/photos) when configured. Discover works
# fine without these; each source is simply skipped if its key is unset.
GOOGLE_PLACES_API_KEY=
TRIPADVISOR_API_KEY=

# Web Push (browser/PWA notifications). Generate a keypair with:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
