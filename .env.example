# Supabase (required) — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (required for AI planning/chat features)
OPENAI_API_KEY=

# Google Calendar OAuth (Milestone: calendar sync)
# Same OAuth Client as Supabase login; add <your-app-url>/api/calendar/google/callback
# to its Authorized redirect URIs.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Symmetric key (32 random bytes, base64) used to encrypt calendar OAuth
# tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Microsoft/Outlook Calendar OAuth (V2)
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Weather provider for "leave now" / weather notifications (V2)
WEATHER_API_KEY=
